    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first()?.json?.body ?? {};\nconst userId = (body.userId ?? '').toString().trim();\n\n// Isolamento: sem userId nao grava nada.\nif (!userId) {\n  return [];\n}\n\nconst requestId = (body.requestId ?? ('exec-' + $execution.id)).toString();\nconst conversationId = (body.conversationId ?? 'conversation-not-defined').toString();\nconst now = new Date().toISOString();\n\n// Aceita apenas confirmacoes explicitas vindas do Hub.\nconst raw = Array.isArray(body.confirmedMemories)\n  ? body.confirmedMemories\n  : (Array.isArray(body.memoryConfirmations) ? body.memoryConfirmations : []);\n\nconst items = [];\nfor (const m of raw) {\n  if (!m) continue;\n  const content = (m.content ?? m.candidate ?? m.text ?? '').toString().trim();\n  if (!content) continue;\n  let scope = (m.scope ?? (m.agentId ? 'agent' : 'user')).toString().toLowerCase().trim();\n  if (scope !== 'agent') scope = 'user';\n  const agentId = scope === 'agent' ? (m.agentId ?? '').toString().toLowerCase().trim() : '';\n  // Memoria de agente exige agent_id.\n  if (scope === 'agent' && !agentId) continue;\n  const category = (m.category ?? '').toString();\n  items.push({\n    json: {\n      user_id: userId,\n      conversation_id: conversationId,\n      request_id: requestId,\n      scope,\n      agent_id: agentId,\n      candidate: content,\n      content,\n      category,\n      status: 'confirmed',\n      recorded_at: now\n    }\n  });\n}\n\nreturn items;"
      },
