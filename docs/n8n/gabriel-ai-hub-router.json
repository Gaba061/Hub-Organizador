    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first()?.json?.body ?? {};\n\nfunction realRows(items) {\n  return (items || [])\n    .map(i => i.json)\n    .filter(j => j && Object.keys(j).length > 0);\n}\n\nconst userRows = realRows($('Ler Memória Usuário').all());\nconst agentRows = realRows($('Ler Memória Agente').all());\n\nconst userParts = userRows\n  .map(r => (r.content || '').toString().trim())\n  .filter(Boolean);\n\nif (body.userMemory) {\n  userParts.push(typeof body.userMemory === 'string' ? body.userMemory : JSON.stringify(body.userMemory));\n}\n\nconst userMemoryText = userParts.join('; ');\n\nconst agentMap = {};\nfor (const r of agentRows) {\n  const aid = (r.agent_id || '').toString().toLowerCase().trim();\n  const c = (r.content || '').toString().trim();\n  if (!aid || !c) continue;\n  if (!agentMap[aid]) agentMap[aid] = [];\n  agentMap[aid].push(c);\n}\n\nconst agentMemoryByAgent = {};\nfor (const k of Object.keys(agentMap)) {\n  agentMemoryByAgent[k] = agentMap[k].join('; ');\n}\n\nreturn [\n  {\n    json: {\n      body,\n      message: body.message ?? '',\n      conversationId: body.conversationId ?? 'conversation-not-defined',\n      userId: body.userId ?? '',\n      userMemoryText,\n      agentMemoryByAgent,\n      userMemoryRowCount: userRows.length,\n      agentMemoryRowCount: agentRows.length\n    }\n  }\n];"
      },
      "id": "19f6d603-f943-4381-8141-03915c88536b",
