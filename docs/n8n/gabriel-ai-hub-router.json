    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first()?.json?.body ?? {};\nconst userId = (body.userId ?? '').toString().trim();\nconst requestId = (body.requestId ?? ('exec-' + $execution.id)).toString();\nconst conversationId = (body.conversationId ?? 'conversation-not-defined').toString();\n\nconst raw = Array.isArray(body.confirmedMemories)\n  ? body.confirmedMemories\n  : (Array.isArray(body.memoryConfirmations) ? body.memoryConfirmations : []);\n\nlet userCount = 0;\nlet agentCount = 0;\nlet ignored = 0;\n\nif (!userId) {\n  return [{ json: { saved: { user: 0, agent: 0 }, ignored: raw.length } }];\n}\n\nfor (const m of raw) {\n  const content = (m?.content ?? m?.candidate ?? m?.text ?? '').toString().trim();\n  if (!content) { ignored++; continue; }\n  let scope = (m?.scope ?? (m?.agentId ? 'agent' : 'user')).toString().toLowerCase().trim();\n  if (scope !== 'agent') scope = 'user';\n  if (scope === 'agent' && !(m?.agentId ?? '').toString().trim()) { ignored++; continue; }\n  if (scope === 'agent') { agentCount++; } else { userCount++; }\n}\n\nreturn [{\n  json: {\n    saved: { user: userCount, agent: agentCount },\n    ignored\n  }\n}];"
      },
      "id": "fe9f29ef-7c74-4f72-8234-e5de15a611d7",
