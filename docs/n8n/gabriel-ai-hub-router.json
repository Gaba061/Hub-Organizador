        "jsCode": "const input = $input.first()?.json ?? {};\nconst conversationId =\n  $('Webhook').first()?.json?.body?.conversationId ?? \"conversation-not-defined\";\n\nconst reply =\n  input.output ??\n  input.reply ??\n  input.text ??\n  input.response ??\n  \"\";\n\nreturn [\n  {\n    json: {\n      conversationId,\n      agentId: \"faculdade\",\n      reply,\n      memoryCandidates: [],\n      citations: [],\n      followUp: \"\"\n    }\n  }\n];"
