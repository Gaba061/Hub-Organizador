    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first()?.json?.body ?? {};\nconst action = (body.action ?? '').toString().trim().toLowerCase();\nconst isConfirm = action === 'confirmmemory';\n\nconst userId = (body.userId ?? '').toString().trim();\nconst conversationId = (body.conversationId ?? '').toString().trim();\nconst requestId = (body.requestId ?? '').toString().trim();\nconst message = (body.message ?? '').toString().trim();\n\nconst missing = [];\nif (!userId) missing.push('userId');\nif (!conversationId) missing.push('conversationId');\nif (!requestId) missing.push('requestId');\n// message so e obrigatorio para mensagens normais (nao para confirmMemory)\nif (!isConfirm && !message) missing.push('message');\n\nconst valid = missing.length === 0;\n\nreturn [{\n  json: {\n    valid,\n    isConfirm,\n    conversationId: conversationId || null,\n    errorMessage: valid ? '' : ('Campos obrigatorios ausentes ou invalidos: ' + missing.join(', '))\n  }\n}];"
      },
