      "id": "c89ede08-b11a-49db-89e2-0208f95eb7cf",
      "name": "Chamar Orquestrador",
      "type": "n8n-nodes-base.messageAnAgent",
      "typeVersion": 3.1,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first()?.json ?? {};\nconst body = $('Webhook').first()?.json?.body ?? {};\n\nconst rawReply =\n  input.output ??\n  input.reply ??\n  input.text ??\n  input.response ??\n  \"\";\n\nfunction parseReply(value) {\n  if (typeof value === \"object\" && value !== null) {\n    return value;\n  }\n  if (typeof value !== \"string\") {\n    return {};\n  }\n  let cleaned = value.trim();\n  const fence = String.fromCharCode(96).repeat(3);\n  if (cleaned.startsWith(fence)) {\n    cleaned = cleaned.slice(fence.length).replace(/^json/i, \"\").trim();\n    if (cleaned.endsWith(fence)) {\n      cleaned = cleaned.slice(0, -fence.length).trim();\n    }\n  }\n  try {\n    return JSON.parse(cleaned);\n  } catch {\n    return {};\n  }\n}\n\nconst parsed = parseReply(rawReply);\n\nconst rawAgentId =\n  parsed.agentId ??\n  parsed.route ??\n  input.agentId ??\n  \"clarify\";\n\nconst agentId = String(rawAgentId).toLowerCase().trim();\n\nconst reply =\n  parsed.reply ??\n  parsed.answer ??\n  parsed.clarifyingQuestion ??\n  (typeof rawReply === \"string\" ? rawReply : \"\");\n\nreturn [\n  {\n    json: {\n      conversationId:\n        body.conversationId ??\n        input.conversationId ??\n        parsed.conversationId ??\n        \"conversation-not-defined\",\n\n      agentId,\n\n      message: body.message ?? \"\",\n      userId: body.userId ?? \"\",\n      userMemory: body.userMemory ?? null,\n      agentMemory: body.agentMemory ?? null,\n      attachments: Array.isArray(body.attachments) ? body.attachments : [],\n\n      reply,\n\n      memoryCandidates:\n        parsed.memoryCandidates ??\n        input.memoryCandidates ??\n        [],\n\n      citations:\n        parsed.citations ??\n        input.citations ??\n        [],\n\n      followUp:\n        parsed.followUp ??\n        input.followUp ??\n        \"\"\n    }\n  }\n];"
      },
