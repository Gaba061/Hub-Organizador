    {
      "parameters": {
        "jsCode": "const body = $('Webhook').first()?.json?.body ?? {};\nconst resp = $input.first()?.json ?? {};\n\nconst userId = (body.userId ?? '').toString();\nconst conversationId = (resp.conversationId ?? body.conversationId ?? 'conversation-not-defined').toString();\nconst agentId = (resp.agentId ?? 'desconhecida').toString();\nconst userMessage = (body.message ?? '').toString();\nconst assistantReply = (resp.reply ?? '').toString();\nconst now = new Date().toISOString();\n\n// Idempotencia por evento: o Hub deve enviar um requestId unico por chamada.\n// Sem requestId, cai para o id da execucao (garante que user+assistant do\n// mesmo turno compartilhem a chave; um retry sem requestId ainda pode duplicar).\nconst requestId = (body.requestId ?? ('exec-' + $execution.id)).toString();\n\n// Nao grava sem userId (isolamento por usuario)\nif (!userId.trim()) {\n  return [];\n}\n\nconst rows = [];\nif (userMessage.trim()) {\n  rows.push({ role: 'user', message: userMessage });\n}\nif (assistantReply.trim()) {\n  rows.push({ role: 'assistant', message: assistantReply });\n}\n\nreturn rows.map(r => ({\n  json: {\n    user_id: userId,\n    conversation_id: conversationId,\n    request_id: requestId,\n    agent_id: agentId,\n    role: r.role,\n    message: r.message,\n    recorded_at: now\n  }\n}));"
      },
